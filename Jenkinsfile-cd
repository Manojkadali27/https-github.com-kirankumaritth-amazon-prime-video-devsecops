pipeline {
  agent any

  environment {
    IMAGE = 'supersection/primevideo:latest'
  }

  stages {
    stage('Checkout') {
      steps {
        git url: 'https://github.com/Manojkadali27/amazon-prime-video-devsecops.git'
      }
    }

    stage('Deploy to EKS') {
      steps {
        sh 'kubectl apply -f manifest.yml'
      }
    }
  }

  post {
    success {
      echo "✅ App successfully deployed to EKS"
    }
    failure {
      echo "❌ EKS deployment failed"
    }
  }
}
